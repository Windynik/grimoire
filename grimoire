#!/usr/bin/env bash
# One command to install and start Grimoire:  ./grimoire
#
# The first run makes a Python environment in .venv and installs the
# requirements. Later runs reuse it, and install again only when
# requirements.txt changes. Then the server starts and the browser opens.
#
#   ./grimoire              set up when needed, start, and open the browser
#   ./grimoire --no-browser start without opening the browser
#   ./grimoire --setup      set up only, do not start
#   ./grimoire --with-mcp   also install the MCP server for AI assistants
#   ./grimoire --check      say what the command would do, and change nothing
#
# GRIMOIRE_PORT sets the port (default 8133). PYTHON sets the Python to use.
set -euo pipefail

cd "$(dirname "$0")"

PORT="${GRIMOIRE_PORT:-8133}"
VENV=".venv"
STAMP="$VENV/.grimoire-requirements"
OPEN_BROWSER=1
START=1
WITH_MCP=0
CHECK=0

for arg in "$@"; do
  case "$arg" in
    --no-browser) OPEN_BROWSER=0 ;;
    --setup) START=0 ;;
    --with-mcp) WITH_MCP=1 ;;
    --check) CHECK=1 ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Unknown option: $arg (see ./grimoire --help)" >&2; exit 2 ;;
  esac
done

say() { printf '\033[1;33m›\033[0m %s\n' "$*"; }

# Find a Python 3.9 or newer. The versions the requirements are tested on
# come first, so a very new Python (with no ready-made packages yet) is the
# last choice.
find_python() {
  for candidate in "${PYTHON:-}" python3.13 python3.12 python3.11 python3.10 python3.9 python3 python; do
    [ -n "$candidate" ] || continue
    if command -v "$candidate" >/dev/null 2>&1 &&
       "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

requirements_hash() {
  local files="requirements.txt"
  [ "$WITH_MCP" = 1 ] && files="$files requirements-mcp.txt"
  # shellcheck disable=SC2086
  cat $files | shasum | cut -c1-16
}

# A setup with the MCP server keeps it in later runs.
[ -f "$VENV/.grimoire-mcp" ] && WITH_MCP=1

PY="$(find_python)" || {
  echo "Grimoire needs Python 3.9 or newer. Install it from https://www.python.org, then run ./grimoire again." >&2
  exit 1
}

WANT="$(requirements_hash)"
HAVE="$(cat "$STAMP" 2>/dev/null || true)"

if [ "$CHECK" = 1 ]; then
  say "Python: $PY ($("$PY" -c 'import platform; print(platform.python_version())'))"
  if [ ! -x "$VENV/bin/python" ]; then say "Would make the environment in $VENV"; fi
  if [ "$WANT" != "$HAVE" ]; then say "Would install the requirements"; else say "The requirements are installed"; fi
  [ "$START" = 1 ] && say "Would start Grimoire on http://127.0.0.1:$PORT"
  exit 0
fi

if [ ! -x "$VENV/bin/python" ]; then
  say "Making the Python environment in $VENV (first run only)…"
  "$PY" -m venv "$VENV"
fi

if [ "$WANT" != "$HAVE" ]; then
  say "Installing the requirements…"
  "$VENV/bin/python" -m pip install --quiet --upgrade pip
  if [ "$WITH_MCP" = 1 ]; then
    # One resolve for both files, so the MCP packages keep FastAPI's limits.
    "$VENV/bin/python" -m pip install --quiet -r requirements.txt -r requirements-mcp.txt
    touch "$VENV/.grimoire-mcp"
  else
    "$VENV/bin/python" -m pip install --quiet -r requirements.txt
  fi
  echo "$WANT" > "$STAMP"
fi

if [ "$START" = 0 ]; then
  say "Grimoire is set up. Run ./grimoire to start it."
  exit 0
fi

URL="http://127.0.0.1:$PORT"
if [ "$OPEN_BROWSER" = 1 ]; then
  (
    # Open the browser when the server answers (at most about 30 seconds).
    for _ in $(seq 1 60); do
      if curl -fsS -o /dev/null "$URL/api/cache/status" 2>/dev/null; then
        if command -v open >/dev/null 2>&1; then open "$URL"
        elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$URL" >/dev/null 2>&1
        fi
        exit 0
      fi
      sleep 0.5
    done
  ) &
fi

say "Starting Grimoire on $URL (press Ctrl-C to stop)"
exec "$VENV/bin/python" -m uvicorn main:app --host 127.0.0.1 --port "$PORT" --log-level warning
